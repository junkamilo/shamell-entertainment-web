{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/auth.html" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/modules/auth/**/*.ts",
    "src/common/auth/**/*.ts",
    "!src/**/*.module.ts",
    "!src/**/*.dto.ts",
    "!src/**/dto/**",
    "!src/**/types/**"
  ],
  "jest": {
    "projectType": "custom",
    "enableFindRelatedTests": false,
    "config": {
      "moduleFileExtensions": ["js", "json", "ts"],
      "rootDir": ".",
      "roots": [
        "<rootDir>/test/unit/modules/auth/",
        "<rootDir>/test/unit/common/auth/"
      ],
      "moduleNameMapper": {
        "^@app/(.*)$": "<rootDir>/src/$1",
        "^@test-support/(.*)$": "<rootDir>/test/support/$1"
      },
      "testRegex": ".*\\.spec\\.ts$",
      "transform": { "^.+\\.(t|j)s$": "ts-jest" },
      "testEnvironment": "node"
    }
  },
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
