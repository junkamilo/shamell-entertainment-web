{
  "name": "shamell-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "scripts": {
    "prisma:restore": "node scripts/restore-prisma-cli.mjs",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate deploy",
    "build": "node scripts/run-prisma.mjs generate && tsc -p tsconfig.build.json && node scripts/copy-email-assets.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/run-prisma.mjs migrate deploy && node dist/main.js",
    "lint": "node scripts/run-prisma.mjs generate && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:cov:upcoming": "jest modules/upcoming-events --coverage --runInBand --collectCoverageFrom=\"modules/upcoming-events/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:venue-reservations": "jest modules/venue-reservations --coverage --runInBand --collectCoverageFrom=\"modules/venue-reservations/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:bookings": "jest modules/bookings --coverage --runInBand --collectCoverageFrom=\"modules/bookings/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:auth": "jest modules/auth --coverage --runInBand --collectCoverageFrom=\"modules/auth/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:availability": "jest modules/availability --coverage --runInBand --collectCoverageFrom=\"modules/availability/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:events": "jest modules/events --coverage --runInBand --collectCoverageFrom=\"modules/events/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:contact": "jest modules/contact --coverage --runInBand --collectCoverageFrom=\"modules/contact/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:venue-tables": "jest modules/venue-tables --coverage --runInBand --collectCoverageFrom=\"modules/venue-tables/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:standalone-chairs": "jest modules/standalone-chairs --coverage --runInBand --collectCoverageFrom=\"modules/standalone-chairs/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:gallery": "jest modules/gallery --coverage --runInBand --collectCoverageFrom=\"modules/gallery/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:floor-layout": "jest modules/floor-layout --coverage --runInBand --collectCoverageFrom=\"modules/floor-layout/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:header-media": "jest modules/header-media --coverage --runInBand --collectCoverageFrom=\"modules/header-media/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:services": "jest modules/services --coverage --runInBand --collectCoverageFrom=\"modules/services/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "test:cov:venue-layout-settings": "jest modules/venue-layout-settings --coverage --runInBand --collectCoverageFrom=\"modules/venue-layout-settings/**/*.ts\" --collectCoverageFrom=\"!**/*.module.ts\" --collectCoverageFrom=\"!**/*.dto.ts\" --collectCoverageFrom=\"!**/__mocks__/**\" --collectCoverageFrom=\"!**/*.spec.ts\" --collectCoverageFrom=\"!**/testing/**\"",
    "resend:venue-confirmation": "ts-node -r tsconfig-paths/register scripts/resend-venue-seat-confirmation.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "mailersend": "^3.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/__mocks__/**",
      "!**/*.dto.ts",
      "!**/testing/**",
      "!**/*.spec.ts",
      "!**/*.integration.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
